{
    "manifest_version": 3,
    "name": "Hiyd",
    "version": "1.3.0",
    "description": "Capture highlighted text and page metadata as markdown.",
    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.ext.js"
    },
    "action": {
        "default_title": "Hiyd Settings",
        "default_popup": "settings.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "turndown.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}